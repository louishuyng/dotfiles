{
  "servers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "cua-driver": {
      "type": "stdio",
      "command": "/Applications/CuaDriver.app/Contents/MacOS/cua-driver",
      "args": ["mcp"],
      "enabled": true
    }
  },
  "hooks": [
    {
      "id": "ponytail",
      "context": "ponytail",
      "event": "sessionStart",
      "enabled": true,
      "disabledAgents": []
    },
    {
      "id": "caveman",
      "event": "sessionStart",
      "skill": "caveman",
      "enabled": true,
      "disabledAgents": []
    },
    {
      "id": "rex",
      "event": "sessionStart",
      "command": "'/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex' --autostart=false __internal session-start 2>/dev/null || true",
      "enabled": false,
      "disabledAgents": []
    },
    {
      "id": "instructions",
      "context": "instructions",
      "event": "sessionStart",
      "enabled": true,
      "disabledAgents": [
        "codex",
        "claude",
        "opencode",
        "grok",
        "grok-build",
        "gemini",
        "copilot",
        "pi",
        "goose",
        "amp",
        "windsurf",
        "antigravity",
        "cline",
        "roo",
        "kilo",
        "qwen",
        "kiro",
        "droid",
        "aider",
        "continue"
      ]
    }
  ]
}
