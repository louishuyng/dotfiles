#!/bin/bash
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/config.sh"
P="$CONFIG_DIR/plugins"
mkdir -p "$HOME/.cache/sketchybar"; rm -f "$HOME/.cache/sketchybar/popup."* "$HOME/.cache/sketchybar/popup_open" "$HOME/.cache/sketchybar/"{front_app.last,media_le}   # also the previous-app-name and fill-position caches (front_app.sh, media.sh) · popups are rebuilt · and the open-popup record (if left behind, the first click is eaten as a close)
(defaults read -g AppleInterfaceStyle 2>/dev/null || echo Light) > "$HOME/.cache/sketchybar/theme"
mkdir -p "$(dirname "$CWD_FILE")"
a() { printf '0x%02x%s' $((BAR_OPACITY * 255 / 100)) "${1:4}"; }   # apply BAR_OPACITY alpha to a color

# island version (12f): bar background transparent, two islands left and right of the notch. The islands are the island.left / island.right brackets below
# 2026.09.30 tuning: left/right/top 5 = matches the Rectangle window gap of 5, height 33 (bottom edge 38 = notch), corner 13 = screen curvature (about 18) - 5, concentric
# find the bar display (BAR_DISPLAY, default main) and measure relative to it — same rule on any Mac and any display (10-06)
#   notch left/right edges differ per machine → measured with helper/notch (790~1010 on this Mac). Without a notch: the screen center twice. On failure: the screen center
#   media island right edge = notch left − 5 / without a notch, center − 5 (notch_l, read by media.sh). bar_x0 = left edge of that display (global x; media.sh positions the island relative to the display)
source "$CONFIG_DIR/plugins/display.sh"   # bar display and notch calculation (popup_guard.sh runs it again when the display setup changes)
# Appear at once: while the bar is being built it sits far below the screen (y 4000); when the items, their first values and the island widths are all in place, the last lines move it to its spot (y 5)
#   hidden=on would put every item at -9999 so the media island width (media.sh) cannot be computed; moving it up would show it on a display above, so it goes down. If this script dies midway the trap still brings it back
BAR_AWAY=4000; trap 'command sketchybar --bar y_offset=5' EXIT
# Batching: the sketchybar calls below are collected and sent in one go at each flush (110+ calls become a few). Only --query goes out at once. One bad command in a batch does not stop the rest (measured)
#   flush before an outside script (spaces.sh, cat.sh) looks for items. Batching is switched off before the first values
Q=(); sketchybar() { case "$1" in --query) command sketchybar "$@" ;; *) Q+=("$@") ;; esac; }
flush() { [ ${#Q[@]} -gt 0 ] && command sketchybar "${Q[@]}"; Q=(); }
# notch_width = the real notch width (only used on a notch display — on a display without a notch SketchyBar ignores it and splits at the center). The 5 on the notch side is handled by the notch.gap item at the front of q, so both cases are '− 5'
sketchybar --bar position=top height=$BAR_H notch_display_height=$NOTCH_H color=0x00000000 blur_radius=0 border_width=0 corner_radius=0 \
  shadow=off margin=5 y_offset=$BAR_AWAY padding_left=0 padding_right=0 notch_width=$NOTCH_W display=$BAR_DISPLAY topmost=window
flush   # move the bar off screen first

sketchybar --default updates=when_shown \
  icon.font="$FONT:Regular:12.0" label.font="$FONT:Regular:12.0" \
  icon.color=$TEXT3 label.color=$TEXT \
  icon.padding_left=0 icon.padding_right=6 label.padding_left=0 label.padding_right=0 \
  padding_left=0 padding_right=0 \
  background.corner_radius=0 background.border_width=0 \
  popup.background.color=$SURFACE popup.background.border_color=$LINE \
  popup.background.border_width=1 popup.background.corner_radius=0 popup.y_offset=2

sketchybar --default y_offset=1   # island: island height is 33 (odd), so text sits 1pt low → raise bar items only by 1 (brackets and popups are set back to 0 below)
sketchybar --add event aerospace_workspace_change \
  --add event shell_cwd \
  --add event theme_change AppleInterfaceThemeChangedNotification \
  --add event meters_click \
  --add event media_layout \
  --add event media_update \
  --add item theme left --set theme drawing=off updates=on script="$P/theme.sh" \
  --subscribe theme theme_change \
  --add item automax left --set automax drawing=off updates=on script="$P/automax.sh" \
  --subscribe automax space_windows_change \
  --add item popups left --set popups drawing=off updates=on script="$P/popup_guard.sh" \
  --subscribe popups front_app_switched aerospace_workspace_change space_change display_change system_woke

spacer() { sketchybar --add item "$1" "$2" --set "$1" width=12 icon.drawing=off label.drawing=off; }

# ── left ──────────────────────────────────────────────
WM_CURSOR_Y=1   # cursor vertical position (up is +). Value that aligns its bottom edge with the text baseline (island: raised 1 along with the text)
# [wordmark▌] — values taken as-is from the design system's components/wordmark.css. For 12px text:
#   JetBrains Mono 400 · cursor width 0.52em=6 · height 0.92em=11 · gap 0.16em=2 · cursor bottom edge = text baseline · accent
#   letter-spacing −0.02em is omitted because SketchyBar has no setting for it
sketchybar --add item wordmark left \
  --set wordmark icon.drawing=off label="workspace" label.font="$FONT:Regular:12.0" \
        label.padding_left=11 label.padding_right=2 \
  --add item wordmark.cursor left \
  --set wordmark.cursor icon.drawing=off label="" label.width=6 y_offset=$WM_CURSOR_Y \
        background.color=$ACCENT background.height=11 background.drawing=on

# AeroSpace updates the wordmark; keep the media island fitted as its name changes.
sketchybar --add item spaces left --set spaces drawing=off updates=on update_freq=5 script="$P/spaces.sh" \
  --subscribe spaces aerospace_workspace_change system_woke
flush; rm -f "$HOME/.cache/sketchybar/spaces.n"; SB_BOOT=1 CONFIG_DIR="$CONFIG_DIR" "$P/spaces.sh"

# code — app name only. The window title was removed
# app.padl 12 = moves the app name's left padding outside the cell (the app-menu popup starts at the left end of the underline). Its name must not be space.* so it stays outside the spaces background
spacer app.padl left; sketchybar --set app.padl width=12
sketchybar --add item front_app left \
  --set front_app icon.drawing=on icon.font="sketchybar-app-font:Regular:14.0" icon.color=$TEXT2 icon.width=16 icon.padding_right=6 label.color=$TEXT2 padding_left=0 padding_right=11 script="$P/front_app.sh" \
        popup.align=left click_script="CONFIG_DIR='$CONFIG_DIR' bash '$P/appmenu.sh' open" \
  --subscribe front_app front_app_switched mouse.entered mouse.exited   # click opens the app-menu popup (rev 10)

# ~/code/project  git:main
sketchybar --add item cwd left \
  --set cwd drawing=off icon.drawing=off label.color=$TEXT3 label.padding_left=12 script="$P/git.sh" \
  --subscribe cwd shell_cwd \
  --add item git left \
  --set git icon="git:" icon.padding_left=12 icon.padding_right=0 label.color=$TEXT2 \
        label.padding_right=12 drawing=off

# ♪ music · next event — only when present
sketchybar --add item cal left \
  --set cal padding_left=12 padding_right=12 drawing=off update_freq=60 script="$P/calendar.sh" click_script="$P/popup_click.sh cal" \
  --subscribe cal system_woke


# the now-playing refresh signal is media_update — media_change is a built-in SketchyBar event (not delivered on macOS 15.4+), so --trigger does not wake the script (confirmed 2026-10-01)
(nohup "$P/media_watch.sh" >/dev/null 2>&1 &)   # media-control stream → sends media_update only when the now-playing info changes

# ── media island (rev 3) — left of the notch (q), 5 from the notch edge (notch_width 230 = real notch 220 (x 790~1010, measured via NSScreen) + 5×2). Always shown ──
# width: fills from the left island's end + 5 to the notch − 5 — media.sh measures the left island's width and sizes the title cell to fit
# [ EQ (2×3, gap 2) 8 app·title (tag↔value 8, 28 chars …) 12 « 12 ❚❚ 12 » ] island inner left/right 11
CTLF="label.width=14 label.align=center label.color=$TEXT3 icon.drawing=off label.y_offset=1"   # « » ❚❚ are drawn 1pt below the island center, so raised (▶ is 0, set in media.sh)
# in q, the item added first is closest to the notch → start from the right (volume)
# volume: [» divider · glyph (cell 34) · 5-cell gauge (2×10 · gap 2, same rhythm as the EQ bars) · 11] — no number. Value, device and popup are in vol.sh
# filling gaps inside the island: an item's window is only as wide as its 'content'; padding is empty space. Clicking empty space made the old progress-fill cover plate window underneath
# take the click, come in front of the text windows and cover all the island text (2026-10-01, reproduced by clicking the 2pt between volume gauge bars · window order measured).
# → cover every spot inside the island with text-side item windows: gaps go inside the label cell (gap included in label.width + label.padding) instead of item padding,
#   the 12 between title and « goes on the left of the « cell. The gauge and EQ areas are transparent click cells
# vol.ul: underline from the glyph to the gauge end, and parent of the volume popup — popup right edge = underline right edge. Own footprint 0 (fixed padding,
# fixed value). A bracket underline sat behind the progress-fill cover plate (an item window), so its top 1px was covered and it looked thin → use an item background (same 2pt as the other cells' underlines)
sketchybar --add item notch.gap q --set notch.gap width=5 icon.drawing=off label.drawing=off   # media island ↔ notch (or screen center if none) 5 — front of q = closest to the notch
sketchybar --add item vol.ul q --set vol.ul padding_left=-52 padding_right=11 icon.drawing=off label="" label.width=41 popup.align=right \
  click_script="$P/popup_click.sh vol.ul"
# vol.pad: transparent click cell covering the island's inner right 11 + the gauge 18. Own footprint is 11 (label width 29 + padding −18).
# created before the bars so it is below the bar windows and above the cover-plate window — it takes clicks even on the 2pt between bars
sketchybar --add item vol.pad q --set vol.pad padding_left=-18 padding_right=0 icon.drawing=off label="" label.width=29 \
  background.drawing=on background.color=0x00000000 background.height=$NOTCH_H click_script="$P/popup_click.sh vol.ul"
for c in 5 4 3 2 1; do gap=2; [ $c = 5 ] && gap=0
  sketchybar --add item vol.$c q --set vol.$c icon.drawing=off label="" label.width=2 background.height=10 \
    background.color=$LINE background.drawing=on padding_right=$gap click_script="$P/popup_click.sh vol.ul"; done
# glyph 12pt (16 is 1.7× the height of « ▶ » — ink 24×23 vs 12~14px @2x), centered in a 34 cell: the divider↔glyph and glyph↔gauge padding are inside the cell, so no gaps
sketchybar --add item vol q --set vol icon=$'\xf3\xb0\x95\xbe' icon.font="JetBrainsMono Nerd Font Propo:Regular:12.0" icon.color=$TEXT2 \
        icon.width=34 icon.align=center icon.padding_right=0 label.drawing=off padding_right=0 update_freq=10 \
        script="$P/vol.sh" click_script="$P/popup_click.sh vol.ul" \
  --subscribe vol volume_change system_woke
# mute (keyboard mute key etc.) and output device changes do not send volume_change, so helper/audio watch observes CoreAudio directly and calls vol.sh
pkill -f '^/[^ ]*/helper/audio watch' 2>/dev/null   # only those whose command line starts with the helper path (so another command line containing the same text is not killed)
(nohup "$CONFIG_DIR/helper/audio" watch "CONFIG_DIR='$CONFIG_DIR' SENDER=routine NAME=vol bash '$P/vol.sh'" >/dev/null 2>&1 &)
# divider: 1pt × 12 between « ▶ » and the volume, color --text-3 (contrast 3.4 on the island background --line · 2.2 on the progress fill. --bg had contrast 1.3 and was invisible)
DISC="$HOME/.cache/sketchybar/disc"; mkdir -p "$DISC/play" "$DISC/tmp"   # spinning-disc frames (helper/discpng): playing = accent ×8 rotations, paused = --text-3, idle = --line
"$CONFIG_DIR/helper/discpng" $ACCENT 18 8 "$DISC/play"
"$CONFIG_DIR/helper/discpng" $TEXT3 18 1 "$DISC/tmp" && mv "$DISC/tmp/disc-0.png" "$DISC/paused.png"
"$CONFIG_DIR/helper/discpng" $LINE 18 1 "$DISC/tmp" && mv "$DISC/tmp/disc-0.png" "$DISC/idle.png"
sketchybar --add item vol.sep q --set vol.sep icon.drawing=off label="" label.width=1 padding_left=0 padding_right=0 \
  background.drawing=on background.color=$TEXT3 background.height=12 click_script="$P/popup_click.sh vol.ul"
sketchybar --add item media.next q --set media.next label="»" $CTLF label.width=24 label.padding_right=10 padding_right=0 script="$P/media.sh" \
  --subscribe media.next mouse.entered mouse.exited \
  --add item media.play q --set media.play label="▶" $CTLF label.width=26 label.padding_right=12 padding_right=0 script="$P/media.sh" \
  --subscribe media.play mouse.entered mouse.exited \
  --add item media.prev q --set media.prev label="«" $CTLF label.width=38 label.padding_left=12 label.padding_right=12 padding_right=0 script="$P/media.sh" \
  --subscribe media.prev mouse.entered mouse.exited \
  --add item media q --set media icon=media icon.padding_right=8 icon.color=$TEXT3 icon.drawing=off label="—" label.color=$TEXT3 label.align=left \
        padding_right=0 update_freq=2 popup.align=left script="$P/media.sh" click_script="$P/popup_click.sh media" \
  --subscribe media media_layout media_update \
  --add item media.disc q --set media.disc icon.drawing=off label="" label.width=18 padding_left=9 padding_right=8 \
        background.drawing=on background.color=0x00000000 background.height=18 background.image.scale=0.5 background.image="$DISC/idle.png" \
  --add item media.hit q --set media.hit width=35 padding_left=0 padding_right=-35 icon.drawing=off label.drawing=off \
        background.drawing=on background.color=0x00000000 background.height=$NOTCH_H click_script="$P/popup_click.sh media"
# media.hit: transparent click cell from the island's left edge to just before the title (9 + disc 18 + 8 = 35). Leftmost q item, own footprint 0 (see 'filling gaps' above)

# ── right (the item added first is the rightmost) ─────────────────
# 2026.09.30: tag --text-3 · value --text · tag↔value 8 · value↔value within a cell 12 · cell↔cell 24 · bracket↔bracket 48
# brackets: [port · agent]  [cpu mem bat · wifi]  [clock]
# [09.28 14:22] — click opens the calendar (rev 6); scrolling over it changes the month
sketchybar --add item clock right \
  --set clock padding_left=12 padding_right=11 icon.padding_right=8 update_freq=1 script="$P/clock_tick.sh" \
        popup.align=right click_script="$P/popup_click.sh clock" \
  --subscribe clock system_woke \
  --add item clock.cal right --set clock.cal drawing=off updates=on update_freq=10 script="$P/clock.sh" \
  --subscribe clock.cal system_woke   # clock text every 1s (lightweight clock_tick), calendar popup every 10s (clock.sh). The date cell is also the same color as the bar

# wifi:ssid — click shows ssid / ip / router (rev 6)
sketchybar --add item wifi right \
  --set wifi icon="wifi" padding_left=24 icon.padding_right=8 padding_right=12 \
        update_freq=30 popup.align=right script="$P/wifi.sh" click_script="CONFIG_DIR='$CONFIG_DIR' bash '$P/wifi_scan.sh'" \
  --subscribe wifi wifi_change system_woke
# bat ▮▮▮▮▯ — click opens the BATTERY popup (rev 8, bat.sh). cpu·mem are the cat circle outside the island (below). The 24 to the previous cell is agent.codex's right padding (so the underline and popup start at the text)
python3 "$P/pixel.py" "$HOME/.cache/sketchybar/px" $TEXT $TEXT3 $WARN $ERR   # pixel icon PNGs (port · ts · cat) - regenerated every time in the theme colors
PXI="icon.background.drawing=on icon.background.color=0x00000000 icon.background.image.scale=0.5 icon.background.image.drawing=on icon.padding_left=0 icon.padding_right=0 label.drawing=off"
for m in bat; do
  for c in 5 4 3 2 1; do
    gap=2; [ $c = 5 ] && gap=0
    sketchybar --add item $m.$c right \
      --set $m.$c icon.drawing=off label="" label.width=4 background.height=10 \
            background.color=$LINE background.drawing=on padding_right=$gap \
            click_script="$P/popup_click.sh bat"
  done
  sketchybar --add item $m right \
    --set $m icon=$m icon.padding_left=0 icon.padding_right=4 label.drawing=off \
          update_freq=30 popup.align=left script="$P/bat.sh" click_script="$P/popup_click.sh bat" \
    --subscribe $m power_source_change system_woke
done
# [agent ✳ 40%  ◎ 12%  ✶ 8%] — claude·codex 5-hour usage, grok weekly pool (rev 6). tag↔glyph 8 · glyph↔% 4 · pair↔pair 12
AG="JetBrainsMono Nerd Font Propo:Regular:14.0"   # the Mono variant shrinks icons to one cell width and they look small, hence Propo
GF="sketchybar-app-font:Regular:14.0"   # :grok_bot: ligature; JetBrainsMono has no grok glyph
sketchybar --add item agent.grok right \
  --set agent.grok icon=":grok_bot:" icon.font="$GF" icon.color=$TEXT icon.padding_right=4 label="—" label.color=$TEXT3 padding_right=24 \
        click_script="$P/popup_click.sh agent" \
  --add item agent.codex right \
  --set agent.codex icon=$'\xee\xb2\x81' icon.font="$AG" icon.color=$TEXT icon.padding_right=4 label="—" label.color=$TEXT3 padding_right=12 \
        click_script="$P/popup_click.sh agent" \
  --add item agent.claude right \
  --set agent.claude icon=$'\xee\xb2\x82' icon.font="$AG" icon.color=0xffd97757 icon.padding_right=4 label="—" label.color=$TEXT3 padding_right=12 \
        click_script="$P/popup_click.sh agent" \
  --add item agent right \
  --set agent icon=agent icon.padding_right=8 label.drawing=off update_freq=15 popup.align=left \
        script="$P/agent.sh" click_script="$P/popup_click.sh agent"
spacer agent.gap right; sketchybar --set agent.gap width=11   # island inner left 11 (rev 8: 24 between all island cells, 11 at both ends)


# ── circles and capsule outside the island (rev 8): (settings) 5 (cat) 5 (port│ts) 5 [right island] ──
spacer isl.gap right; sketchybar --set isl.gap width=5   # capsule ↔ right island 5
# app capsule: inner left/right padding 11 (common island rule) · 19 between icons (image end↔image start). The circles (settings, cat) are circles, so exempt from the padding rule — image centered in the circle; the border is the apps.cap bracket (below). Each cell has its own click and popup
sketchybar --add item ts right \
  --set ts icon="" icon.width=12 $PXI padding_left=0 padding_right=10 icon.background.image="$HOME/.cache/sketchybar/px/ts_off.png" \
        update_freq=30 popup.align=left script="$P/ts.sh" click_script="SENDER=routine CONFIG_DIR='$CONFIG_DIR' bash '$P/ts.sh'; '$P/popup_click.sh' ts" \
  --subscribe ts system_woke
sketchybar --add item ports right \
  --set ports icon="" icon.width=12 $PXI padding_left=0 padding_right=18 icon.background.image="$HOME/.cache/sketchybar/px/port.png" \
        update_freq=15 popup.align=left script="$P/ports.sh" click_script="$P/popup_click.sh ports"
spacer apps.pad right; sketchybar --set apps.pad width=11   # capsule inner left 11 (common island rule). Right 11 = 1 empty in the icon cell + ts right 10
# a left-aligned popup starts at the item's left padding → moved the cell padding outside port·ts (apps.pad · port right 18) so the popup starts at the left end of the white underline bar (by request 10-02)
# cat circle: circle 33 (background --bg · border --line). y_offset 0 — inheriting the island cell default (1) raises the circle 1pt and clips its top border outside the bar window (measured 10-06) + one image of grass and cat (px/cc_*.png, cat.sh swaps frames). Click opens SYSTEM
#   cpu.ul = 12×2 underline and parent of the SYSTEM popup (the popup starts at the underline's left end). It must be created after the circle to be drawn above the circle background → an item to the left of the circle,
#   right padding −22 so it overlaps the bottom center of the circle; left padding 10 gives that back, so the item to its left is not pulled in
sketchybar --add item cpu right --set cpu icon="" icon.width=33 icon.padding_left=0 icon.padding_right=0 label.drawing=off padding_left=0 padding_right=5 y_offset=0 \
        background.drawing=on background.color=$BG background.height=33 background.corner_radius=16 background.border_width=1 background.border_color=$LINE \
        background.image="$HOME/.cache/sketchybar/px/cc_1.png" background.image.scale=0.5 background.image.drawing=on \
        update_freq=5 script="$P/meters.sh" click_script="$P/popup_click.sh cpu.ul" \
  --subscribe cpu power_source_change volume_change system_woke \
  --add item cpu.ul right --set cpu.ul icon.drawing=off label="" label.width=12 padding_left=10 padding_right=-22 popup.align=left y_offset=0 \
        click_script="$P/popup_click.sh cpu.ul"
flush; (nohup "$P/cat.sh" >/dev/null 2>&1 &)
# pilo circle: 5 left of the cat circle. Live agents in herdr as a round face with two arms; pilo_anim.sh swaps the frames (started by pilo.sh). Same structure as the cat circle (circle 33 · pilo.ul = underline and PILO popup parent, overlapped under the circle's centre).
#   Popup left edge = left end of the underline; pilo.sh switches to right alignment only when there is no room on the right.
#   Hidden at first - pilo.sh turns it on after its first read. PILO_ISLAND=0 hides it
#   updates=on: a hidden item gets no periodic updates by default (when_shown)
#   agent_status_change: fired by agent_watch.sh (hc events) when a herdr terminal starts, ends, or changes status → pilo.sh runs at once. The 30s poll is the backstop
sketchybar --add event agent_status_change
(nohup "$P/agent_watch.sh" >/dev/null 2>&1 &)
sketchybar --add item pilo right --set pilo icon="" icon.width=33 icon.padding_left=0 icon.padding_right=0 label.drawing=off padding_left=0 padding_right=5 y_offset=0 drawing=off \
        background.drawing=on background.color=$BG background.height=33 background.corner_radius=16 background.border_width=1 background.border_color=$LINE \
        background.image="$HOME/.cache/sketchybar/px/pilo_idle_1.png" background.image.scale=0.5 background.image.drawing=on \
        update_freq=30 updates=on script="$P/pilo.sh" click_script="$P/popup_click.sh pilo.ul" \
  --subscribe pilo agent_status_change system_woke \
  --add item pilo.ul right --set pilo.ul icon.drawing=off label="" label.width=12 padding_left=10 padding_right=-22 popup.align=left y_offset=0 drawing=off \
        click_script="$P/popup_click.sh pilo.ul"

# ci ✗ · docker — only when present
#   each gets its own capsule (docker.cap · ci.cap below); the 5 gap spacer on its right is shown and hidden with the item by its script
spacer docker.gap right; sketchybar --set docker.gap width=5 drawing=off
sketchybar --add item docker right \
  --set docker icon=docker padding_left=11 padding_right=11 drawing=off \
        update_freq=30 popup.align=left script="$P/docker.sh" click_script="$P/popup_click.sh docker" \
  --add item ci.gap right --set ci.gap width=5 icon.drawing=off label.drawing=off drawing=off \
  --add item ci right \
  --set ci icon.drawing=off label.color=$ERR padding_left=11 padding_right=11 drawing=off \
        update_freq=120 popup.align=left script="$P/ci.sh" click_script="$P/popup_click.sh ci"

# settings circle (rev 4) — 5 left of the right island, circle 33, click opens config.sh. Glyph: SETTINGS_GLYPH (config.sh)
sketchybar --add item settings right \
  --set settings icon="$SETTINGS_GLYPH" icon.font="$SETTINGS_FONT" icon.color=$TEXT \
        icon.width=33 icon.align=center icon.padding_left=0 icon.padding_right=0 icon.y_offset=2 label.drawing=off \
        background.drawing=on background.color=$BG background.height=33 background.corner_radius=16 \
        background.border_width=1 background.border_color=$LINE y_offset=0 padding_left=0 padding_right=5 \
        click_script="$P/edit_config.sh"   # background and border same as the other islands (--bg · 1pt --line, by request 10-02). Icon --text. Right 5 = gap

# popup frame — rev 5: surface background · 1px line border · corner 0 · row height 24 · 2px below the bar
sketchybar --default y_offset=0   # from here on brackets (islands, underlines) and popups stay in place
# the two islands — opaque --bg, 1pt --line border, corner 13 (this bar is the only exception to the design system's radius-0 rule). Width follows content
ISL="background.color=$BG background.height=$NOTCH_H background.corner_radius=13 background.border_width=1 background.border_color=$LINE background.drawing=on"
sketchybar --add bracket island.left wordmark wordmark.cursor app.padl front_app cwd git cal \
  --set island.left $ISL \
  --add bracket island.right agent.gap agent agent.claude agent.codex agent.grok bat bat.1 bat.2 bat.3 bat.4 bat.5 wifi clock \
  --set island.right $ISL
sketchybar --add bracket island.media media media.disc media.prev media.play media.next vol.sep vol vol.1 vol.2 vol.3 vol.4 vol.5 vol.pad --set island.media $ISL
flush

# 2px underline under the cell of the open popup (rev 6: cell bottom edge, text color). Width is the text only — cell padding was moved to padding outside the item.
# single-item cells use that item's background; meters use a bracket (cpu.u) as the underline. popup.sh (popup_under) turns it on and off
UL="background.drawing=off background.color=$TEXT background.height=2 background.y_offset=$(( 1 - NOTCH_H / 2 ))"   # just inside the island's bottom border (-1 because items are raised by 1)
for i in clock wifi ports ts cpu.ul pilo.ul docker ci media vol.ul cal front_app; do sketchybar --set $i $UL; done
sketchybar --set ports background.y_offset=-13 --set ts background.y_offset=-13 --set cpu.ul background.y_offset=-12 --set pilo.ul background.y_offset=-12   # circle/capsule underlines: 3 above the cell's bottom edge (rev 8). The cat circle has item y_offset 0, hence −12
sketchybar --add bracket apps.cap apps.pad ports ts --set apps.cap background.drawing=on background.color=$BG background.height=33 \
  background.corner_radius=17 background.border_width=1 background.border_color=$LINE   # app capsule border (end radius 17)
CAP="background.drawing=on background.color=$BG background.height=33 background.corner_radius=17 background.border_width=1 background.border_color=$LINE"
sketchybar --add bracket docker.cap docker --set docker.cap $CAP --add bracket ci.cap ci --set ci.cap $CAP   # same capsule as apps.cap; hidden while its item is hidden
sketchybar --add bracket agent.u agent agent.claude agent.codex agent.grok --set agent.u $UL background.y_offset=$(( 2 - NOTCH_H / 2 ))
sketchybar --add bracket bat.u bat bat.1 bat.2 bat.3 bat.4 bat.5 --set bat.u $UL background.y_offset=$(( 2 - NOTCH_H / 2 ))

for p in cpu.ul pilo.ul bat agent ports ts docker ci media vol.ul cal wifi clock front_app; do
  # popup.height=1: row height is set per row by popup.sh (this value is the minimum height)
  sketchybar --set $p popup.height=1 popup.y_offset=2 popup.background.drawing=on popup.blur_radius=$POPUP_BLUR \
    popup.background.color=$(printf '0x%02x%s' $((POPUP_OPACITY * 255 / 100)) "${SURFACE:4}") popup.background.border_color=$LINE \
    popup.background.border_width=1 popup.background.corner_radius=0
done

# click shield — on macOS 27, clicking an empty part of the bar raises the bar background window above the item windows and hides all the text
# (SketchyBar #850). A transparent bracket wrapping every item makes that window rise instead. Draws nothing
sketchybar --add bracket shield wordmark clock --set shield background.drawing=on background.color=0x00000000 background.height=$NOTCH_H   # only the two end items — putting items that get removed and re-created (space dots, popup rows) into the bracket crashes SketchyBar
flush; unset -f sketchybar   # from here on, send at once
# First values: before showing, run each item script once, together. With SB_BOOT=1 they set only what the bar shows - no popup rows (popup.sh), no width animation (front_app.sh, media.sh).
#   Popups are built after the bar shows, by the --update at the end (with popups 1.5s, values only about 0.5s). Wi-Fi uses the saved name (routine); the slow Shortcut lookup happens afterwards
fill() { SB_BOOT=1 CONFIG_DIR="$CONFIG_DIR" NAME=$1 SENDER=${3:-forced} INFO="$4" bash "$P/$2" >/dev/null 2>&1 & }
FRONT=$(lsappinfo info -only name "$(lsappinfo front)" 2>/dev/null | perl -ne 'print /^"LSDisplayName"="(.*)"$/ ? $1 : /^"([^"]+)"/ ? $1 : "" if $. == 1')   # front app name (two output shapes). If it fails, the event SketchyBar sends shortly fills it in
fill clock clock_tick.sh; fill wifi wifi.sh routine; fill bat bat.sh; fill agent agent.sh; fill cpu meters.sh   # clock.sh (calendar popup) shows nothing on the bar, so it is left out
fill pilo pilo.sh; fill ts ts.sh; fill ports ports.sh; fill vol vol.sh; fill docker docker.sh; fill ci ci.sh   # media is handled below with the width fit (its now-playing lookup can take 2s)
[ -n "$FRONT" ] && fill front_app front_app.sh front_app_switched "$FRONT"
for _ in $(seq 40); do [ -z "$(jobs -r)" ] && break; sleep 0.05; done   # continue as soon as all are done, wait 2s at most (late values fill in place after the bar shows)
SB_BOOT=1 CONFIG_DIR="$CONFIG_DIR" NAME=media SENDER=media_layout bash "$P/media.sh" >/dev/null 2>&1   # fit the media island here, after the left island width is final (as an event it would land after the bar shows). No animation
sketchybar --bar y_offset=5; trap - EXIT
sketchybar --update
sketchybar --query displays | md5 > "$HOME/.cache/sketchybar/displays"   # for the popup_guard comparison
(nohup "$P/blink.sh" >/dev/null 2>&1 &)   # cursor blink
date +%s > "$HOME/.cache/sketchybar/ready"   # marks that everything was loaded (for checks)
